# Copy to .env and fill in real values. See src/promhis/config.py for every
# available PROMHIS_* setting (any field can be overridden this way).

PROMHIS_ADMIN_USER=admin
PROMHIS_ADMIN_PASSWORD=change-me
# Random secret for signing the dashboard session cookie, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROMHIS_SESSION_SECRET=change-me-too

PROMHIS_RETENTION_DAYS=90

# Password for the bundled `postgres` service in docker-compose.yml (user
# and database are both always "promhis"). Change this before exposing
# Promhis beyond your own machine. To use your own external Postgres
# instead of the bundled container, set PROMHIS_DATABASE_URL below and
# comment out docker-compose.yml's `postgres` service.
POSTGRES_PASSWORD=change-me-three
# PROMHIS_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/promhis

# Optional: point at a live Alertmanager to poll as a webhook backup/bootstrap.
# PROMHIS_ALERTMANAGER_URL=http://alertmanager:9093

# Optional: disable or lock down GET /metrics (enabled + open by default).
# PROMHIS_METRICS_ENABLED=false
# PROMHIS_METRICS_ALLOWED_IPS=10.0.0.0/8,127.0.0.1
# PROMHIS_METRICS_USER=prometheus
# PROMHIS_METRICS_PASSWORD=change-me

# Optional: scheduled pg_dump backups (off by default; can also be toggled
# from the Settings page when PROMHIS_DB_DUMP_ENABLED is unset here).
# PROMHIS_DB_DUMP_ENABLED=true
# PROMHIS_DB_DUMP_PATH=/var/lib/promhis/dumps
# PROMHIS_DB_DUMP_INTERVAL_HOURS=24
# PROMHIS_DB_DUMP_MIN_FREE_MB=500
